ne-block;\n      background: var(--ivory-50);\n      color: var(--plum-900);\n      font-weight: 600;\n      font-size: 14px;\n      padding: 12px 24px;\n      border-radius: var(--radius-sm);\n      text-decoration: none;\n      transition: transform 120ms var(--ease), background-color 150ms ease;\n    }\n    .header-cta:hover { transform: scale(0.98); background: var(--ivory-100); }\n    .container {\n      max-width: 1080px;\n      margin: 0 auto;\n      padding: 40px 24px 80px;\n    }\n    .search-bar {\n      background: var(--card-bg);\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius-md);\n      padding: 8px 16px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 32px;\n      box-shadow: 0 4px 20px rgba(66, 24, 52, 0.04);\n    }\n    .search-bar input {\n      width: 100%;\n      border: none;\n      outline: none;\n      font-size: 15px;\n      color: var(--text-dark);\n      background: transparent;\n      padding: 8px 0;\n    }\n    .search-bar input::placeholder { color: var(--text-muted); }\n    .section-title {\n      font-size: 22px;\n      font-weight: 700;\n      color: var(--plum-900);\n      margin-bottom: 20px;\n    }\n    .grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n      gap: 24px;\n      margin-bottom: 56px;\n    }\n    .card {\n      background: var(--card-bg);\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius-lg);\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      box-shadow: 0 2px 12px rgba(66, 24, 52, 0.03);\n      transition: transform 150ms var(--ease), box-shadow 150ms ease, border-color 150ms ease;\n    }\n    @media (hover: hover) and (pointer: fine) {\n      .card:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 8px 24px rgba(66, 24, 52, 0.08);\n        border-color: rgba(66, 24, 52, 0.25);\n      }\n    }\n    .card-model {\n      font-size: 19px;\n      font-weight: 700;\n      color: var(--plum-900);\n      margin-bottom: 6px;\n    }\n    .card-details {\n      font-size: 14px;\n      color: var(--text-muted);\n      margin-bottom: 20px;\n      flex-grow: 1;\n    }\n    .card-footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding-top: 16px;\n      border-top: 1px solid var(--ivory-200);\n    }\n    .rate-label {\n      font-size: 11px;\n      font-weight: 600;\n      text-transform: uppercase;\n      color: var(--text-muted);\n    }\n    .rate-val {\n      font-size: 18px;\n      font-weight: 700;\n      color: var(--plum-800);\n    }\n    .card-btn {\n      background: var(--plum-800);\n      color: var(--ivory-50);\n      border: none;\n      padding: 8px 16px;\n      border-radius: var(--radius-sm);\n      font-size: 13px;\n      font-weight: 600;\n      cursor: pointer;\n      transition: transform 120ms var(--ease), background-color 150ms ease;\n    }\n    .card-btn:hover { transform: scale(0.97); background: var(--plum-700); }\n    .state-box {\n      background: var(--card-bg);\n      border: 1px dashed var(--border-color);\n      border-radius: var(--radius-md);\n      padding: 48px 24px;\n      text-align: center;\n      color: var(--text-muted);\n      font-size: 14px;\n      grid-column: 1 / -1;\n    }\n    .inquiry-section {\n      background: var(--card-bg);\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius-lg);\n      padding: 40px;\n      box-shadow: 0 4px 24px rgba(66, 24, 52, 0.05);\n      max-width: 680px;\n      margin: 0 auto;\n    }\n    .inquiry-section h2 {\n      font-size: 24px;\n      font-weight: 700;\n      color: var(--plum-900);\n      margin-bottom: 8px;\n    }\n    .inquiry-section p {\n      font-size: 14px;\n      color: var(--text-muted);\n      margin-bottom: 24px;\n    }\n    .form-group {\n      margin-bottom: 18px;\n    }\n    .form-group label {\n      display: block;\n      font-size: 13px;\n      font-weight: 600;\n      color: var(--plum-900);\n      margin-bottom: 6px;\n    }\n    .form-group input,\n    .form-group textarea {\n      width: 100%;\n      background: var(--ivory-50);\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius-sm);\n      padding: 10px 14px;\n      font-size: 14px;\n      color: var(--text-dark);\n      outline: none;\n      transition: border-color 150ms ease, box-shadow 150ms ease;\n      font-family: inherit;\n    }\n    .form-group input:focus,\n    .form-group textarea:focus {\n      border-color: var(--plum-700);\n      box-shadow: 0 0 0 3px rgba(92, 34, 74, 0.12);\n    }\n    .submit-btn {\n      background: var(--plum-900);\n      color: var(--ivory-50);\n      border: none;\n      width: 100%;\n      padding: 12px;\n      border-radius: var(--radius-sm);\n      font-size: 15px;\n      font-weight: 600;\n      cursor: pointer;\n      transition: transform 120ms var(--ease), background-color 150ms ease;\n    }\n    .submit-btn:hover { transform: scale(0.98); background: var(--plum-800); }\n    .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }\n    .form-status {\n      margin-top: 14px;\n      padding: 10px 14px;\n      border-radius: var(--radius-sm);\n      font-size: 13px;\n      display: none;\n    }\n    .form-status.success {\n      display: block;\n      background: #eef8f1;\n      color: #1b6333;\n      border: 1px solid #c2e6cd;\n    }\n    .form-status.error {\n      display: block;\n      background: #fdf2f2;\n      color: #9b1c1c;\n      border: 1px solid #f8b4b4;\n    }\n    footer {\n      text-align: center;\n      padding: 32px 24px;\n      font-size: 13px;\n      color: var(--text-muted);\n      border-top: 1px solid var(--border-color);\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <span class=\"header-badge\">Cebu Moto Rentals</span>\n    <h1>Cebu Rides Showroom</h1>\n    <p>Explore our premium fleet of reliable scooters and touring motorcycles. Reserve yours with zero hassle.</p>\n    <a href=\"#inquire\" class=\"header-cta\">Inquire Now</a>\n  </header>\n\n  <div class=\"container\">\n    <div class=\"search-bar\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--text-muted)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg>\n      <input type=\"text\" id=\"search\" placeholder=\"Search model or specs...\">\n    </div>\n\n    <h2 class=\"section-title\">Available Motorcycles</h2>\n    <div id=\"fleet-container\" class=\"grid\">\n      <div class=\"state-box\">Loading available motorcycles...</div>\n    </div>\n\n    <section id=\"inquire\" class=\"inquiry-section\">\n      <h2>Ask About a Motorcycle</h2>\n      <p>Send an inquiry for availability, special rates, or booking details.</p>\n      <form data-everyops-form=\"inquiry_form\" id=\"inquiryForm\">\n        <div class=\"form-group\">\n          <label for=\"inq_name\">Your Name</label>\n          <input type=\"text\" id=\"inq_name\" name=\"name\" required placeholder=\"e.g. Maria Santos\">\n        </div>\n        <div class=\"form-group\">\n          <label for=\"inq_phone\">Phone Number</label>\n          <input type=\"tel\" id=\"inq_phone\" name=\"phone\" required placeholder=\"e.g. 0917 123 4567\">\n        </div>\n        <div class=\"form-group\">\n          <label for=\"inq_message\">Message</label>\n          <textarea id=\"inq_message\" name=\"message\" rows=\"4\" placeholder=\"Which motorcycle are you interested in and on what dates?\"></textarea>\n        </div>\n        <button type=\"submit\" class=\"submit-btn\">Send Inquiry</button>\n        <div data-everyops-message class=\"form-status\"></div>\n      </form>\n    </section>\n  </div>\n\n  <footer>\n    <p>\u00a9 2026 Cebu Moto \u00b7 All rights reserved.</p>\n  </footer>\n\n  <script>\n    let catalogItems = [];\n\n    function renderCatalog(items) {\n      const container = document.getElementById('fleet-container');\n      if (!items || items.length === 0) {\n        container.innerHTML = '<div class=\"state-box\">No motorcycles found matching your query.</div>';\n        return;\n      }\n      container.innerHTML = '';\n      items.forEach(row => {\n        const card = document.createElement('div');\n        card.className = 'card';\n\n        const nameCell = row.cells.find(c => c.fieldId === 'name');\n        const rateCell = row.cells.find(c => c.fieldId === 'rate');\n        const detailsCell = row.cells.find(c => c.fieldId === 'details');\n\n        const modelName = nameCell ? nameCell.text : 'Motorcycle';\n\n        const titleEl = document.createElement('div');\n        titleEl.className = 'card-model';\n        titleEl.textContent = modelName;\n\n        const detailsEl = document.createElement('div');\n        detailsEl.className = 'card-details';\n        detailsEl.textContent = (detailsCell && detailsCell.text) ? detailsCell.text : 'Reliable and maintained unit.';\n\n        const footerEl = document.createElement('div');\n        footerEl.className = 'card-footer';\n\n        const rateBox = document.createElement('div');\n        const rateLabel = document.createElement('div');\n        rateLabel.className = 'rate-label';\n        rateLabel.textContent = 'Daily Rate';\n        const rateVal = document.createElement('div');\n        rateVal.className = 'rate-val';\n        rateVal.textContent = (rateCell && rateCell.text) ? rateCell.text : '\u20b1\u2014';\n        rateBox.appendChild(rateLabel);\n        rateBox.appendChild(rateVal);\n\n        const btn = document.createElement('button');\n        btn.className = 'card-btn';\n        btn.textContent = 'Inquire';\n        btn.onclick = () => {\n          const msgInput = document.getElementById('inq_message');\n          if (msgInput) {\n            msgInput.value = 'Hi, I would like to inquire about the ' + modelName + '.';\n          }\n          document.getElementById('inquire').scrollIntoView({ behavior: 'smooth' });\n        };\n\n        footerEl.appendChild(rateBox);\n        footerEl.appendChild(btn);\n\n        card.appendChild(titleEl);\n        card.appendChild(detailsEl);\n        card.appendChild(footerEl);\n        container.appendChild(card);\n      });\n    }\n\n    async function loadCatalog() {\n      const container = document.getElementById('fleet-container');\n      try {\n        const res = await EveryOps.data('catalog_data');\n        if (res && res.ok && res.layout && res.layout.sections) {\n          const section = res.layout.sections[0];\n          if (section && section.items && section.items[0] && section.items[0].data) {\n            catalogItems = section.items[0].data.items || [];\n            renderCatalog(catalogItems);\n            return;\n          }\n        }\n        container.innerHTML = '<div class=\"state-box\">No catalog items available right now.</div>';\n      } catch (err) {\n        container.innerHTML = '<div class=\"state-box\">Unable to load motorcycle catalog.</div>';\n      }\n    }\n\n    document.getElementById('search').addEventListener('input', (e) => {\n      const q = e.target.value.toLowerCase().trim();\n      if (!q) {\n        renderCatalog(catalogItems);\n        return;\n      }\n      const filtered = catalogItems.filter(row => {\n        const nameCell = row.cells.find(c => c.fieldId === 'name');\n        const detailsCell = row.cells.find(c => c.fieldId === 'details');\n        const nameText = (nameCell && nameCell.text) ? nameCell.text.toLowerCase() : '';\n        const detailsText = (detailsCell && detailsCell.text) ? detailsCell.text.toLowerCase() : '';\n        return nameText.includes(q) || detailsText.includes(q);\n      });\n      renderCatalog(filtered);\n    });\n\n    loadCatalog();\n  </script>\n</body>\n</html>"
