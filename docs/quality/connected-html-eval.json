                "name": "Ride Cebu",
                "type": "html",
                "public": true,
                "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Ride Cebu \u2014 Motorcycle Rentals</title>\n  <style>\n    :root {\n      --bg-ivory: #FAF6F0;\n      --surface-ivory: #F3ECE1;\n      --card-bg: #FFFFFF;\n      --plum-900: #240E1E;\n      --plum-800: #33152B;\n      --plum-700: #4A1E3E;\n      --plum-600: #6B2C5A;\n      --plum-100: #F2E4EE;\n      --text-main: #240E1E;\n      --text-muted: #6B5B67;\n      --border-soft: #E3D7C8;\n      --radius-sm: 8px;\n      --radius-md: 14px;\n      --radius-lg: 22px;\n      --ease: cubic-bezier(0.23, 1, 0.32, 1);\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background-color: var(--bg-ivory);\n      color: var(--text-main);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n      padding-bottom: 80px;\n    }\n\n    .container {\n      max-width: 1040px;\n      margin: 0 auto;\n      padding: 0 24px;\n    }\n\n    header.hero {\n      padding: 72px 0 48px;\n      text-align: center;\n    }\n\n    .badge {\n      display: inline-block;\n      text-transform: uppercase;\n      letter-spacing: 0.14em;\n      font-size: 0.72rem;\n      font-weight: 700;\n      color: var(--plum-700);\n      background: var(--plum-100);\n      padding: 6px 14px;\n      border-radius: 999px;\n      margin-bottom: 20px;\n    }\n\n    h1.hero-title {\n      font-family: \"Playfair Display\", Georgia, serif;\n      font-size: clamp(2.4rem, 5vw, 3.8rem);\n      font-weight: 700;\n      line-height: 1.15;\n      color: var(--plum-900);\n      max-width: 760px;\n      margin: 0 auto 16px;\n    }\n\n    p.hero-subtitle {\n      font-size: 1.15rem;\n      color: var(--text-muted);\n      max-width: 580px;\n      margin: 0 auto 32px;\n    }\n\n    .section-title {\n      font-family: \"Playfair Display\", Georgia, serif;\n      font-size: 1.9rem;\n      color: var(--plum-900);\n      margin-bottom: 8px;\n    }\n\n    .section-desc {\n      color: var(--text-muted);\n      font-size: 0.98rem;\n      margin-bottom: 28px;\n    }\n\n    .fleet-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n      gap: 24px;\n      margin-bottom: 64px;\n    }\n\n    .moto-card {\n      background: var(--card-bg);\n      border: 1px solid var(--border-soft);\n      border-radius: var(--radius-md);\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      box-shadow: 0 4px 20px rgba(36, 14, 30, 0.04);\n      transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);\n    }\n\n    @media (hover: hover) and (pointer: fine) {\n      .moto-card:hover {\n        transform: translateY(-4px);\n        box-shadow: 0 12px 28px rgba(36, 14, 30, 0.08);\n      }\n    }\n\n    .moto-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 12px;\n      margin-bottom: 12px;\n    }\n\n    .moto-name {\n      font-family: \"Playfair Display\", Georgia, serif;\n      font-size: 1.4rem;\n      color: var(--plum-900);\n      font-weight: 600;\n    }\n\n    .moto-rate {\n      font-size: 1.25rem;\n      font-weight: 700;\n      color: var(--plum-700);\n      white-space: nowrap;\n    }\n    .moto-rate span {\n      font-size: 0.8rem;\n      font-weight: 400;\n      color: var(--text-muted);\n    }\n\n    .moto-details {\n      color: var(--text-muted);\n      font-size: 0.92rem;\n      line-height: 1.5;\n      margin-bottom: 20px;\n      flex-grow: 1;\n    }\n\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 12px 20px;\n      font-size: 0.95rem;\n      font-weight: 600;\n      border-radius: var(--radius-sm);\n      border: none;\n      cursor: pointer;\n      transition: transform 0.12s var(--ease), background 0.15s var(--ease), opacity 0.15s;\n      text-decoration: none;\n    }\n\n    .btn:active {\n      transform: scale(0.97);\n    }\n\n    .btn-primary {\n      background: var(--plum-800);\n      color: #FAF6F0;\n    }\n    .btn-primary:hover {\n      background: var(--plum-700);\n    }\n    .btn-secondary {\n      background: var(--surface-ivory);\n      color: var(--plum-800);\n    }\n    .btn-secondary:hover {\n      background: #E8DDCF;\n    }\n\n    .btn-block {\n      width: 100%;\n    }\n\n    /* States */\n    .state-box {\n      background: var(--card-bg);\n      border: 1px dashed var(--border-soft);\n      border-radius: var(--radius-md);\n      padding: 48px 24px;\n      text-align: center;\n      color: var(--text-muted);\n      grid-column: 1 / -1;\n    }\n    .spinner {\n      width: 32px;\n      height: 32px;\n      border: 3px solid var(--border-soft);\n      border-top-color: var(--plum-700);\n      border-radius: 50%;\n      margin: 0 auto 16px;\n      animation: spin 0.8s linear infinite;\n    }\n    @keyframes spin {\n      to { transform: rotate(360deg); }\n    }\n\n    /* Inquiry Section */\n    .inquiry-wrapper {\n      background: var(--surface-ivory);\n      border: 1px solid var(--border-soft);\n      border-radius: var(--radius-lg);\n      padding: 40px;\n      max-width: 640px;\n      margin: 0 auto;\n    }\n\n    .form-group {\n      margin-bottom: 20px;\n    }\n    .form-group label {\n      display: block;\n      font-size: 0.88rem;\n      font-weight: 600;\n      color: var(--plum-900);\n      margin-bottom: 6px;\n    }\n    .form-input {\n      width: 100%;\n      padding: 12px 14px;\n      background: #FFFFFF;\n      border: 1px solid var(--border-soft);\n      border-radius: var(--radius-sm);\n      color: var(--text-main);\n      font-size: 0.95rem;\n      font-family: inherit;\n      outline: none;\n      transition: border-color 0.15s ease;\n    }\n    .form-input:focus {\n      border-color: var(--plum-600);\n      box-shadow: 0 0 0 2px var(--plum-100);\n    }\n    textarea.form-input {\n      resize: vertical;\n      min-height: 100px;\n    }\n\n    .alert {\n      padding: 14px 18px;\n      border-radius: var(--radius-sm);\n      font-size: 0.92rem;\n      margin-bottom: 20px;\n      display: none;\n    }\n    .alert-success {\n      background: #EAF5ED;\n      color: #1B5E20;\n      border: 1px solid #C8E6C9;\n    }\n    .alert-error {\n      background: #FDF0ED;\n      color: #9C1414;\n      border: 1px solid #F8CBC6;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <header class=\"hero\">\n      <div class=\"badge\">Cebu Moto Rentals</div>\n      <h1 class=\"hero-title\">Explore Cebu on Two Wheels</h1>\n      <p class=\"hero-subtitle\">Premium automatic scooters and adventure touring motorcycles for city cruisers and island explorers.</p>\n      <a href=\"#inquiry-section\" class=\"btn btn-primary\">Send an Inquiry</a>\n    </header>\n\n    <section id=\"fleet-section\">\n      <h2 class=\"section-title\">Our Fleet</h2>\n      <p class=\"section-desc\">Well-maintained scooters ready for daily and weekly rentals.</p>\n      <div id=\"fleet-container\" class=\"fleet-grid\">\n        <div class=\"state-box\">\n          <div class=\"spinner\"></div>\n          <p>Loading available motorcycles\u2026</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"inquiry-section\">\n      <div class=\"inquiry-wrapper\">\n        <h2 class=\"section-title\" style=\"text-align: center; margin-bottom: 8px;\">Ask About a Rental</h2>\n        <p class=\"section-desc\" style=\"text-align: center; margin-bottom: 28px;\">Leave your details and preferred model. We'll get back to you right away.</p>\n\n        <div id=\"alert-status\" class=\"alert\"></div>\n\n        <form id=\"custom-inquiry-form\">\n          <div class=\"form-group\">\n            <label for=\"inquiry-name\">Your Name *</label>\n            <input type=\"text\" id=\"inquiry-name\" class=\"form-input\" placeholder=\"e.g. Maria Santos\" required />\n          </div>\n          <div class=\"form-group\">\n            <label for=\"inquiry-phone\">Phone Number *</label>\n            <input type=\"tel\" id=\"inquiry-phone\" class=\"form-input\" placeholder=\"e.g. 0917 123 4567\" required />\n          </div>\n          <div class=\"form-group\">\n            <label for=\"inquiry-message\">Message or Preferred Motorcycle</label>\n            <textarea id=\"inquiry-message\" class=\"form-input\" placeholder=\"Tell us about your rental dates or preferred bike...\"></textarea>\n          </div>\n          <button type=\"submit\" id=\"submit-btn\" class=\"btn btn-primary btn-block\">Send Inquiry</button>\n        </form>\n      </div>\n    </section>\n  </div>\n\n  <script>\n    const fleetContainer = document.getElementById('fleet-container');\n    const inquiryForm = document.getElementById('custom-inquiry-form');\n    const submitBtn = document.getElementById('submit-btn');\n    const alertStatus = document.getElementById('alert-status');\n    const messageInput = document.getElementById('inquiry-message');\n\n    function showAlert(text, isError) {\n      alertStatus.textContent = text;\n      alertStatus.className = 'alert ' + (isError ? 'alert-error' : 'alert-success');\n      alertStatus.style.display = 'block';\n    }\n\n    function hideAlert() {\n      alertStatus.style.display = 'none';\n    }\n\n    async function loadFleet() {\n      fleetContainer.innerHTML = `\n        <div class=\"state-box\">\n          <div class=\"spinner\"></div>\n          <p>Loading available motorcycles\u2026</p>\n        </div>\n      `;\n\n      try {\n        const res = await EveryOps.data('catalog_data');\n        if (!res || !res.ok) {\n          throw new Error(res && res.message ? res.message : 'Failed to retrieve catalog');\n        }\n\n        let rows = [];\n        if (res.layout && res.layout.sections) {\n          for (const sec of res.layout.sections) {\n            if (sec.items) {\n              for (const item of sec.items) {\n                if (item.data && Array.isArray(item.data.items)) {\n                  rows = item.data.items;\n                  break;\n                }\n              }\n            }\n            if (rows.length) break;\n          }\n        }\n\n        if (!rows.length) {\n          fleetContainer.innerHTML = `\n            <div class=\"state-box\">\n              <p>No motorcycles currently listed in the fleet.</p>\n            </div>\n          `;\n          return;\n        }\n\n        fleetContainer.innerHTML = '';\n        rows.forEach(row => {\n          let name = '';\n          let rate = '';\n          let details = '';\n\n          if (Array.isArray(row.cells)) {\n            row.cells.forEach(c => {\n              if (c.fieldId === 'name') name = c.text || '';\n              if (c.fieldId === 'rate') rate = c.text || '';\n              if (c.fieldId === 'details') details = c.text || '';\n            });\n          }\n\n          const card = document.createElement('div');\n          card.className = 'moto-card';\n\n          const header = document.createElement('div');\n          header.className = 'moto-header';\n\n          const titleEl = document.createElement('h3');\n          titleEl.className = 'moto-name';\n          titleEl.textContent = name || 'Motorcycle';\n\n          const rateEl = document.createElement('div');\n          rateEl.className = 'moto-rate';\n          rateEl.textContent = rate;\n          const daySpan = document.createElement('span');\n          daySpan.textContent = rate ? ' / day' : '';\n          rateEl.appendChild(daySpan);\n\n          header.appendChild(titleEl);\n          header.appendChild(rateEl);\n\n          const descEl = document.createElement('p');\n          descEl.className = 'moto-details';\n          descEl.textContent = details || 'Inquire for rental details and availability.';\n\n          const actionBtn = document.createElement('button');\n          actionBtn.className = 'btn btn-secondary btn-block';\n          actionBtn.textContent = 'Inquire About This Model';\n          actionBtn.addEventListener('click', () => {\n            messageInput.value = 'Hi! I am inquiring about the ' + (name || 'motorcycle') + '.';\n            document.getElementById('inquiry-section').scrollIntoView({ behavior: 'smooth' });\n            document.getElementById('inquiry-name').focus();\n          });\n\n          card.appendChild(header);\n          card.appendChild(descEl);\n          card.appendChild(actionBtn);\n          fleetContainer.appendChild(card);\n        });\n\n      } catch (err) {\n        fleetContainer.innerHTML = `\n          <div class=\"state-box\">\n            <p style=\"margin-bottom:12px;\">Unable to load motorcycles at this time.</p>\n            <button id=\"retry-btn\" class=\"btn btn-secondary\">Try Again</button>\n          </div>\n        `;\n        const retry = document.getElementById('retry-btn');\n        if (retry) retry.addEventListener('click', loadFleet);\n      }\n    }\n\n    inquiryForm.addEventListener('submit', async (e) => {\n      e.preventDefault();\n      hideAlert();\n\n      const name = document.getElementById('inquiry-name').value.trim();\n      const phone = document.getElementById('inquiry-phone').value.trim();\n      const message = messageInput.value.trim();\n\n      if (!name || !phone) {\n        showAlert('Please provide both your name and phone number.', true);\n        return;\n      }\n\n      submitBtn.disabled = true;\n      submitBtn.textContent = 'Sending...';\n\n      try {\n        const res = await EveryOps.submit('inquiry_form', {\n          name: name,\n          phone: phone,\n          message: message\n        });\n\n        if (res && res.ok) {\n          showAlert('Thank you! Your inquiry has been sent. We will contact you shortly.', false);\n          inquiryForm.reset();\n        } else {\n          showAlert(res && res.message ? res.message : 'Could not submit inquiry. Please try again.', true);\n        }\n      } catch (err) {\n        showAlert('An unexpected error occurred while sending your inquiry.', true);\n      } finally {\n        submitBtn.disabled = false;\n        submitBtn.textContent = 'Send Inquiry';\n      }\n    });\n\n    loadFleet();\n  </script>\n</body>\n</html>"
              }
            }
          ],
          "recordOps": []
        }
      }
    },
