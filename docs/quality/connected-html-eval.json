                "name": "Live Search",
                "type": "html",
                "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style>\n    :root {\n      --bg: #09090b;\n      --card: #18181b;\n      --border: #27272a;\n      --text-main: #fafafa;\n      --text-muted: #a1a1aa;\n      --accent: #3b82f6;\n      --accent-glow: rgba(59, 130, 246, 0.15);\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      background: var(--bg);\n      color: var(--text-main);\n      padding: 24px;\n      line-height: 1.5;\n    }\n    .container {\n      max-width: 900px;\n      margin: 0 auto;\n    }\n    .header {\n      margin-bottom: 24px;\n    }\n    .header h1 {\n      font-size: 24px;\n      font-weight: 600;\n      letter-spacing: -0.02em;\n      margin-bottom: 6px;\n    }\n    .header p {\n      color: var(--text-muted);\n      font-size: 14px;\n    }\n    .controls {\n      display: flex;\n      gap: 12px;\n      margin-bottom: 20px;\n    }\n    .search-input {\n      flex: 1;\n      background: var(--card);\n      border: 1px solid var(--border);\n      color: var(--text-main);\n      padding: 10px 14px;\n      border-radius: 8px;\n      font-size: 14px;\n      outline: none;\n      transition: border-color 0.15s ease, box-shadow 0.15s ease;\n    }\n    .search-input:focus {\n      border-color: var(--accent);\n      box-shadow: 0 0 0 3px var(--accent-glow);\n    }\n    .grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n      gap: 16px;\n    }\n    .item-card {\n      background: var(--card);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      padding: 18px;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      transition: transform 0.15s cubic-bezier(0.23, 1, 0.32, 1), border-color 0.15s ease;\n    }\n    .item-card:hover {\n      border-color: #3f3f46;\n    }\n    .item-title {\n      font-size: 16px;\n      font-weight: 600;\n    }\n    .item-details {\n      font-size: 13px;\n      color: var(--text-muted);\n      flex-grow: 1;\n    }\n    .metrics {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 8px;\n      padding-top: 12px;\n      border-top: 1px solid var(--border);\n    }\n    .metric-label {\n      font-size: 11px;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n      color: var(--text-muted);\n      margin-bottom: 2px;\n    }\n    .metric-val {\n      font-size: 14px;\n      font-weight: 600;\n    }\n    .status-box {\n      padding: 32px;\n      text-align: center;\n      color: var(--text-muted);\n      font-size: 14px;\n      background: var(--card);\n      border-radius: 12px;\n      border: 1px dashed var(--border);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>Live Motorcycle Inventory</h1>\n      <p>Custom private overview with real-time search</p>\n    </div>\n    <div class=\"controls\">\n      <input type=\"text\" id=\"search\" class=\"search-input\" placeholder=\"Search by model or details...\">\n    </div>\n    <div id=\"content\" class=\"status-box\">Loading live inventory...</div>\n  </div>\n\n  <script>\n    let allItems = [];\n\n    function render(items) {\n      const container = document.getElementById('content');\n      if (!items || items.length === 0) {\n        container.className = 'status-box';\n        container.textContent = 'No matching motorcycles found.';\n        return;\n      }\n      container.className = 'grid';\n      container.innerHTML = '';\n      items.forEach(row => {\n        const card = document.createElement('div');\n        card.className = 'item-card';\n\n        const nameCell = row.cells.find(c => c.fieldId === 'name');\n        const rateCell = row.cells.find(c => c.fieldId === 'rate');\n        const detailsCell = row.cells.find(c => c.fieldId === 'details');\n        const costCell = row.cells.find(c => c.fieldId === 'cost');\n\n        const titleEl = document.createElement('div');\n        titleEl.className = 'item-title';\n        titleEl.textContent = nameCell ? nameCell.text : 'Unnamed';\n\n        const detailsEl = document.createElement('div');\n        detailsEl.className = 'item-details';\n        detailsEl.textContent = detailsCell && detailsCell.text ? detailsCell.text : 'No details provided';\n\n        const metricsEl = document.createElement('div');\n        metricsEl.className = 'metrics';\n\n        const rateBox = document.createElement('div');\n        rateBox.innerHTML = '<div class=\"metric-label\">Daily Rate</div><div class=\"metric-val\">' + (rateCell ? rateCell.text : '\u2014') + '</div>';\n\n        const costBox = document.createElement('div');\n        costBox.innerHTML = '<div class=\"metric-label\">Internal Cost</div><div class=\"metric-val\">' + (costCell ? costCell.text : '\u2014') + '</div>';\n\n        metricsEl.appendChild(rateBox);\n        metricsEl.appendChild(costBox);\n\n        card.appendChild(titleEl);\n        card.appendChild(detailsEl);\n        card.appendChild(metricsEl);\n        container.appendChild(card);\n      });\n    }\n\n    async function loadData() {\n      const container = document.getElementById('content');\n      try {\n        const res = await EveryOps.data('stock');\n        if (res && res.ok) {\n          allItems = res.items || [];\n          render(allItems);\n        } else {\n          container.className = 'status-box';\n          container.textContent = res.message || 'Failed to load inventory data.';\n        }\n      } catch (err) {\n        container.className = 'status-box';\n        container.textContent = 'Error loading inventory.';\n      }\n    }\n\n    document.getElementById('search').addEventListener('input', (e) => {\n      const q = e.target.value.toLowerCase().trim();\n      if (!q) {\n        render(allItems);\n        return;\n      }\n      const filtered = allItems.filter(row => {\n        const nameCell = row.cells.find(c => c.fieldId === 'name');\n        const detailsCell = row.cells.find(c => c.fieldId === 'details');\n        const nameText = (nameCell && nameCell.text) ? nameCell.text.toLowerCase() : '';\n        const detailsText = (detailsCell && detailsCell.text) ? detailsCell.text.toLowerCase() : '';\n        return nameText.includes(q) || detailsText.includes(q);\n      });\n      render(filtered);\n    });\n\n    loadData();\n  </script>\n</body>\n</html>"
