# Copy to .env.local, or run `pnpm env:pull` to fill it from Google Secret Manager.
# Local development goes through the Cloud SQL Auth Proxy (`pnpm db:proxy`, port 5433).
DATABASE_URL=postgres://everyops_runtime:password@127.0.0.1:5433/everyops
# On Cloud Run: postgres://everyops_runtime:password@/everyops?host=/cloudsql/everyops-prod:asia-southeast1:everyops-db
# Only for a direct TLS connection: path to the server CA, which is then verified.
# DATABASE_CA_PATH=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# "Continue with Google". OAuth client "EveryOps web" in Google Auth Platform; pnpm env:pull fills these.
# Redirect URIs: https://everyops.app, https://www.everyops.app and http://localhost:3000 + /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared secret for POST /api/cron/reset-demo (Cloud Scheduler, nightly). Secret Manager: everyops-cron-secret.
# CRON_SECRET=
# Gemini on Vertex AI. Locally it signs in with gcloud's Application Default Credentials; on Cloud Run as everyops-run.
# GOOGLE_CLOUD_PROJECT=everyops-prod
# GEMINI_LOCATION=asia-southeast1
# GEMINI_MODEL=gemini-3.5-flash
# AI_RATE_LIMIT=30
# Email (invites, password resets) through Hostinger mail as notify@everyops.app.
# The password lives in Secret Manager as everyops-smtp-password; pnpm env:pull fills it in.
# Without these, emails are written to the server log instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notify@everyops.app
SMTP_PASSWORD=
MAIL_FROM="EveryOps <notify@everyops.app>"
# Optional: public address used in email links (defaults to BETTER_AUTH_URL).
# APP_URL=https://everyops.app
# Optional: extra origins allowed to call the auth API, comma separated.
# BETTER_AUTH_TRUSTED_ORIGINS=https://everyops-web-223724593768.asia-southeast1.run.app
# Optional private beta: only allowlisted or approved emails can create an account; anyone else joins the
# waitlist table. Off unless set to true; existing users can always sign in. Allowlist emails are separated by
# commas, semicolons or spaces and matched ignoring case. On Cloud Run these come from the GitHub production
# environment (see README, "Private beta").
# PRIVATE_BETA_ENABLED=true
# PRIVATE_BETA_ALLOWLIST=first@example.com,second@example.com
