# Copy to .env.local, or run `pnpm env:pull` to fill it from AWS Secrets Manager.
DATABASE_URL=postgres://everyops_runtime:password@host:5432/everyops
# TLS is verified against certs/rds-global-bundle.pem. Set to "disable" only for a local Postgres.
# DATABASE_SSL=disable
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: enables "Continue with Google".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
