# Copy to .env.local, or run `pnpm env:pull` to fill it from Google Secret Manager.
# Local development goes through the Cloud SQL Auth Proxy (`pnpm db:proxy`, port 5433).
DATABASE_URL=postgres://everyops_runtime:password@127.0.0.1:5433/everyops
# On Cloud Run: postgres://everyops_runtime:password@/everyops?host=/cloudsql/everyops-prod:asia-southeast1:everyops-db
# Only for a direct TLS connection: path to the server CA, which is then verified.
# DATABASE_CA_PATH=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: enables "Continue with Google".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Gemini on Vertex AI. Locally it signs in with gcloud's Application Default Credentials; on Cloud Run as everyops-run.
# GOOGLE_CLOUD_PROJECT=everyops-prod
# GEMINI_LOCATION=asia-southeast1
# GEMINI_MODEL=gemini-3.5-flash
# AI_RATE_LIMIT=30
